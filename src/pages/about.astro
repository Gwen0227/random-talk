---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

// 社群連結：之後只要改這裡的 href 就好
const socials = [
  {
    label: 'Instagram',
    icon: 'lucide:instagram',
    href: 'https://instagram.com/your-id', // 換成你的帳號
  },
  {
    label: 'X (Twitter)',
    icon: 'lucide:twitter',
    href: 'https://x.com/your-id', // 換成你的帳號
  },
  {
    label: 'Bluesky',
    icon: 'lucide:cloud',
    href: 'https://bsky.app/profile/your-id.bsky.social', // 換成你的帳號
  },
  {
    label: 'Portfolio',
    icon: 'lucide:globe',
    href: 'https://example.com', // 先放假的，之後換成作品集網址
  },
  {
    label: 'Email',
    icon: 'lucide:mail',
    href: 'mailto:your-email@example.com', // 先放假的
  },
]
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">
          I'm Gwen. I love anime, art, and everything creative, and I'm
          passionate about making things.
        </p>
        <p>
          This is where I write down my thoughts after finishing a work.
        </p>
      </div>

      <h2 class="mb-4 text-2xl font-medium">Find me</h2>
      <ul class="grid gap-3 sm:grid-cols-2" role="list">
        {
          socials.map(({ label, icon, href }) => (
            <li>
              <Link
                href={href}
                external
                class="flex items-center gap-3 rounded-lg border border-border/50 p-4 hover:bg-muted/50"
              >
                <Icon name={icon} class="size-5 text-muted-foreground" />
                <span class="font-medium">{label}</span>
              </Link>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
