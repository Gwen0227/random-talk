---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'

// 取得所有文章
const allPosts = await getAllPosts()

const postsPerPage = SITE.postsPerPage || 5
const initialPosts = allPosts.slice(0, postsPerPage)
const totalPages = Math.ceil(allPosts.length / postsPerPage)

// GitHub Pages base path
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />

  {/* Hero */}
  <section
    class="flex flex-col-reverse items-center gap-6 py-12"
  >
    <div class="text-center">
      <h1 class="mb-4 text-3xl font-medium text-foreground md:text-4xl">
        Random Talk
      </h1>

      <p class="font-sans text-lg leading-relaxed text-muted-foreground">
        Anime, manga, and films that leave me wanting to talk. No right
        answers, just my own tastes and feelings.
      </p>
    </div>

    <!-- Avatar：128 × 128px -->
    <div
      class="h-32 w-32 flex-shrink-0 overflow-hidden rounded-full border-4 border-border/50 bg-muted shadow-sm"
    >
      <img
        src={`${baseUrl}/avatar.jpg`}
        alt="Avatar"
        class="h-full w-full object-cover opacity-0 transition-opacity"
        onload="this.style.opacity='1'"
      />
    </div>
  </section>

  {/* 文章 */}
  <section class="mt-8 flex flex-col gap-y-4">
    <h2 class="mb-4 text-2xl font-bold text-foreground">
      Latest posts
    </h2>

    <div
      id="infinite-scroll-wrapper"
      data-current-page="1"
      data-total-pages={totalPages}
      data-base-url={baseUrl}
    >
      <ul
        id="post-container"
        class="flex flex-col gap-y-8"
      >
        {
          initialPosts.map((post) => (
            <li class="border-l-4 border-border/50 pl-4 pr-4">
              <BlogCard entry={post} />
            </li>
          ))
        }
      </ul>

      <div
        id="scroll-sentinel"
        class="mt-8 flex h-20 w-full items-center justify-center"
      >
        <div
          id="loader"
          class="hidden animate-pulse font-sans text-sm text-muted-foreground"
        >
          Loading more posts...
        </div>
      </div>
    </div>
  </section>
</Layout>

